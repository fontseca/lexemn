/* Number literals (decimal, hexadecimal, binary and octal base).  */

CASE("0 42 123456789 3.14159 .5 1. 1.e2 .0e2 .5e-3 1e10 1.6E-19 6.022e+23 10.0e+20 1_000_000",
      { TOK_NUMBER, "0" },
      { TOK_NUMBER, "42" },
      { TOK_NUMBER, "123456789" },
      { TOK_NUMBER, "3.14159" },
      { TOK_NUMBER, ".5" },
      { TOK_NUMBER, "1." },
      { TOK_NUMBER, "1.e2" },
      { TOK_NUMBER, ".0e2" },
      { TOK_NUMBER, ".5e-3" },
      { TOK_NUMBER, "1e10" },
      { TOK_NUMBER, "1.6E-19" },
      { TOK_NUMBER, "6.022e+23" },
      { TOK_NUMBER, "10.0e+20" },
      { TOK_NUMBER, "1_000_000" }),

CASE("0x0 0x1F 0XFF80 0xabcdef 0xFF_FF_00_00",
      { TOK_NUMBER, "0x0" },
      { TOK_NUMBER, "0x1F" },
      { TOK_NUMBER, "0XFF80" },
      { TOK_NUMBER, "0xabcdef" },
      { TOK_NUMBER, "0xFF_FF_00_00" }),

CASE("0b0 0b1 0b1010 0B11001010 0b1111_0000_1010_0101",
      { TOK_NUMBER, "0b0" },
      { TOK_NUMBER, "0b1" },
      { TOK_NUMBER, "0b1010" },
      { TOK_NUMBER, "0B11001010" },
      { TOK_NUMBER, "0b1111_0000_1010_0101" }),

CASE("0o0 0o755 0O777 0o123_456 0755",
      { TOK_NUMBER, "0o0" },
      { TOK_NUMBER, "0o755" },
      { TOK_NUMBER, "0O777" },
      { TOK_NUMBER, "0o123_456" },
      { TOK_NUMBER, "0755" }),

/* String literals.  */

CASE("let const char *str\t\t\t\t\n\n\n\v\r:=\"Lorem ipsum dolor sit amet.\" and \"4x^2 + 5 = 13\"",
     { TOK_NAME, "let" },
     { TOK_NAME, "const" },
     { TOK_NAME, "char" },
     { TOK_MULT },
     { TOK_NAME, "str" },
     { TOK_ASSIGN },
     { TOK_STRING, "Lorem ipsum dolor sit amet." },
     { TOK_NAME, "and" },
     { TOK_STRING, "4x^2 + 5 = 13" }),

CASE("\"Hello \\\"World\\\"\" \"Line 1\\nLine 2\" \"Set: ∩ ∪ ⊆ Ø\"",
     { TOK_STRING, "\"Hello \\\"World\\\"\"" },
     { TOK_STRING, "\"Line 1\\nLine 2\"" },
     { TOK_STRING, "\"Set: ∩ ∪ ⊆ Ø\"" }),

/* Arithmetic operators.  */

CASE("+ - * / ÷ % ++ -- ** ⌊x + 1⌋*⌈y - 2⌉ + [a, b]* {c} ++a%b**(-4)",
     { TOK_PLUS },
     { TOK_MINUS },
     { TOK_MULT },
     { TOK_DIV_1 },
     { TOK_DIV_2 },
     { TOK_MOD },
     { TOK_INC },
     { TOK_DEC },
     { TOK_EXP },
     { TOK_LFLOOR },
     { TOK_NAME, "x" },
     { TOK_PLUS },
     { TOK_NUMBER, "1" },
     { TOK_RFLOOR },
     { TOK_MULT },
     { TOK_LCEILING },
     { TOK_NAME, "y" },
     { TOK_MINUS },
     { TOK_NUMBER, "2" },
     { TOK_RCEILING },
     { TOK_PLUS },
     { TOK_LBRACKET },
     { TOK_NAME, "a" },
     { TOK_COMMA },
     { TOK_NAME, "b" },
     { TOK_RBRACKET },
     { TOK_MULT },
     { TOK_LBRACE },
     { TOK_NAME, "c" },
     { TOK_RBRACE },
     { TOK_INC },
     { TOK_NAME, "a" },
     { TOK_MOD },
     { TOK_NAME, "b" },
     { TOK_EXP },
     { TOK_LPAREN },
     { TOK_MINUS },
     { TOK_NUMBER, "4" },
     { TOK_RPAREN }),

/* Relational operators.  */

CASE("= != <> < > <= >= := : a=b b!=c c<>d e<(f+2) (f-2)>g g<=(h**2) h>=(i%2)",
     { TOK_EQ },
     { TOK_NEQ_1 },
     { TOK_NEQ_2 },
     { TOK_LT },
     { TOK_GT },
     { TOK_LTE },
     { TOK_GTE },
     { TOK_ASSIGN },
     { TOK_COLON },
     { TOK_NAME, "a" },
     { TOK_EQ },
     { TOK_NAME, "b" },
     { TOK_NAME, "b" },
     { TOK_NEQ_1 },
     { TOK_NAME, "c" },
     { TOK_NAME, "c" },
     { TOK_NEQ_2 },
     { TOK_NAME, "d" },
     { TOK_NAME, "e" },
     { TOK_LT },
     { TOK_LPAREN },
     { TOK_NAME, "f" },
     { TOK_PLUS },
     { TOK_NUMBER, "2" },
     { TOK_RPAREN },
     { TOK_LPAREN },
     { TOK_NAME, "f" },
     { TOK_MINUS },
     { TOK_NUMBER, "2" },
     { TOK_RPAREN },
     { TOK_GT },
     { TOK_NAME, "g" },
     { TOK_NAME, "g" },
     { TOK_LTE },
     { TOK_LPAREN },
     { TOK_NAME, "h" },
     { TOK_EXP },
     { TOK_NUMBER, "2" },
     { TOK_RPAREN },
     { TOK_NAME, "h" },
     { TOK_GTE },
     { TOK_LPAREN },
     { TOK_NAME, "i" },
     { TOK_MOD },
     { TOK_NUMBER, "2" },
     { TOK_RPAREN }),

/* Logical operators.  */

CASE("&& || ! a&&b b||c !(c && d || !e)",
     { TOK_AND_AND },
     { TOK_OR_OR },
     { TOK_NOT },
     { TOK_NAME, "a" },
     { TOK_AND_AND },
     { TOK_NAME, "b" },
     { TOK_NAME, "b" },
     { TOK_OR_OR },
     { TOK_NAME, "c" },
     { TOK_NOT },
     { TOK_LPAREN },
     { TOK_NAME, "c" },
     { TOK_AND_AND },
     { TOK_NAME, "d" },
     { TOK_OR_OR },
     { TOK_NOT },
     { TOK_NAME, "e" },
     { TOK_RPAREN }),

/* Bitwise operators.  */

CASE("& | ^ ~ << >> a & b | c ^ ~d << 2 >> 1",
     { TOK_AND },
     { TOK_OR },
     { TOK_XOR },
     { TOK_COMPL },
     { TOK_LSHIFT },
     { TOK_RSHIFT },
     { TOK_NAME, "a" },
     { TOK_AND },
     { TOK_NAME, "b" },
     { TOK_OR },
     { TOK_NAME, "c" },
     { TOK_XOR },
     { TOK_COMPL },
     { TOK_NAME, "d" },
     { TOK_LSHIFT },
     { TOK_NUMBER, "2" },
     { TOK_RSHIFT },
     { TOK_NUMBER, "1" }),

/* Grouping.  */

CASE("( ) [ ] { } ⌊ ⌋ ⌈ ⌉ ⌊x⌋ + ⌈y⌉",
     { TOK_LPAREN },
     { TOK_RPAREN },
     { TOK_LBRACKET },
     { TOK_RBRACKET },
     { TOK_LBRACE },
     { TOK_RBRACE },
     { TOK_LFLOOR },
     { TOK_RFLOOR },
     { TOK_LCEILING },
     { TOK_RCEILING },
     { TOK_LFLOOR },
     { TOK_NAME, "x" },
     { TOK_RFLOOR },
     { TOK_PLUS },
     { TOK_LCEILING },
     { TOK_NAME, "y" },
     { TOK_RCEILING }),

/* Set operators.  */

CASE("∩ ∪ ⊆ ⊄ ⊂ ⊇ ⊅ ⊃ ∆ ∈ ∉ × Ø",
     { TOK_SET_INTER },
     { TOK_SET_UNION },
     { TOK_SET_SUB },
     { TOK_SET_NSUB },
     { TOK_SET_PROPSUB },
     { TOK_SET_SUPER },
     { TOK_SET_NSUPER },
     { TOK_SET_PROPSUPER },
     { TOK_SET_SYMMDIFF },
     { TOK_SET_ELEMOF },
     { TOK_SET_NELEMOF },
     { TOK_SET_CARTPROD },
     { TOK_SET_EMPTY }),

CASE("{A} ∩ {B} {A} ∪ {B} {A} ⊆ {B} {A} ⊄ {B} {A} ⊂ {B} {A} ⊇ {B} {A} ⊅ {B} {A} ⊃ {B} {A} ∆ {B} x ∈ {A} x ∉ {A} {A} × {B} A = Ø",
     { TOK_LBRACE },
     { TOK_NAME, "A" },
     { TOK_RBRACE },
     { TOK_SET_INTER },
     { TOK_LBRACE },
     { TOK_NAME, "B" },
     { TOK_RBRACE },
     { TOK_LBRACE },
     { TOK_NAME, "A" },
     { TOK_RBRACE },
     { TOK_SET_UNION },
     { TOK_LBRACE },
     { TOK_NAME, "B" },
     { TOK_RBRACE },
     { TOK_LBRACE },
     { TOK_NAME, "A" },
     { TOK_RBRACE },
     { TOK_SET_SUB },
     { TOK_LBRACE },
     { TOK_NAME, "B" },
     { TOK_RBRACE },
     { TOK_LBRACE },
     { TOK_NAME, "A" },
     { TOK_RBRACE },
     { TOK_SET_NSUB },
     { TOK_LBRACE },
     { TOK_NAME, "B" },
     { TOK_RBRACE },
     { TOK_LBRACE },
     { TOK_NAME, "A" },
     { TOK_RBRACE },
     { TOK_SET_PROPSUB },
     { TOK_LBRACE },
     { TOK_NAME, "B" },
     { TOK_RBRACE },
     { TOK_LBRACE },
     { TOK_NAME, "A" },
     { TOK_RBRACE },
     { TOK_SET_SUPER },
     { TOK_LBRACE },
     { TOK_NAME, "B" },
     { TOK_RBRACE },
     { TOK_LBRACE },
     { TOK_NAME, "A" },
     { TOK_RBRACE },
     { TOK_SET_NSUPER },
     { TOK_LBRACE },
     { TOK_NAME, "B" },
     { TOK_RBRACE },
     { TOK_LBRACE },
     { TOK_NAME, "A" },
     { TOK_RBRACE },
     { TOK_SET_PROPSUPER },
     { TOK_LBRACE },
     { TOK_NAME, "B" },
     { TOK_RBRACE },
     { TOK_LBRACE },
     { TOK_NAME, "A" },
     { TOK_RBRACE },
     { TOK_SET_SYMMDIFF },
     { TOK_LBRACE },
     { TOK_NAME, "B" },
     { TOK_RBRACE },
     { TOK_NAME, "x" },
     { TOK_SET_ELEMOF },
     { TOK_LBRACE },
     { TOK_NAME, "A" },
     { TOK_RBRACE },
     { TOK_NAME, "x" },
     { TOK_SET_NELEMOF },
     { TOK_LBRACE },
     { TOK_NAME, "A" },
     { TOK_RBRACE },
     { TOK_LBRACE },
     { TOK_NAME, "A" },
     { TOK_RBRACE },
     { TOK_SET_CARTPROD },
     { TOK_LBRACE },
     { TOK_NAME, "B" },
     { TOK_RBRACE },
     { TOK_NAME, "A" },
     { TOK_EQ },
     { TOK_SET_EMPTY }),

CASE("A∩B∪C⊆D⊄E⊂F⊇G⊅H⊃I∆J∈K∉L×M=Ø",
     { TOK_NAME, "A" },
     { TOK_SET_INTER },
     { TOK_NAME, "B" },
     { TOK_SET_UNION },
     { TOK_NAME, "C" },
     { TOK_SET_SUB },
     { TOK_NAME, "D" },
     { TOK_SET_NSUB },
     { TOK_NAME, "E" },
     { TOK_SET_PROPSUB },
     { TOK_NAME, "F" },
     { TOK_SET_SUPER },
     { TOK_NAME, "G" },
     { TOK_SET_NSUPER },
     { TOK_NAME, "H" },
     { TOK_SET_PROPSUPER },
     { TOK_NAME, "I" },
     { TOK_SET_SYMMDIFF },
     { TOK_NAME, "J" },
     { TOK_SET_ELEMOF },
     { TOK_NAME, "K" },
     { TOK_SET_NELEMOF },
     { TOK_NAME, "L" },
     { TOK_SET_CARTPROD },
     { TOK_NAME, "M" },
     { TOK_EQ },
     { TOK_SET_EMPTY }),

/* Miscellaneous operators.  */

CASE(":= , : ; ? # @ .. ...",
     { TOK_ASSIGN },
     { TOK_COMMA },
     { TOK_COLON },
     { TOK_SEMICOLON },
     { TOK_QMARK },
     { TOK_HASH },
     { TOK_ATSIGN },
     { TOK_RANGE },
     { TOK_ELLIPSIS }),

/* Identifiers and meta-commands.  */

CASE("größe español_cigüeña_día 水 カウンタ сумма zß水🍌你好",
     { TOK_NAME, "größe" },
     { TOK_NAME, "español_cigüeña_día" },
     { TOK_NAME, "水" },
     { TOK_NAME, "カウンタ" },
     { TOK_NAME, "сумма" },
     { TOK_NAME, "zß水🍌你好" }),

CASE("1+$c+1 _$pi_ $aaa_bbb_ccc_ddd_eee $E $__PI__ $2_SQRTPI\n\t\t\n\t$SQRT2",
     { TOK_NUMBER, "1" },
     { TOK_PLUS },
     { TOK_CONST, "$c" },
     { TOK_PLUS },
     { TOK_NUMBER, "1" },
     { TOK_NAME, "_" },
     { TOK_CONST, "$pi_" },
     { TOK_CONST, "$aaa_bbb_ccc_ddd_eee" },
     { TOK_CONST, "$E" },
     { TOK_CONST, "$__PI__" },
     { TOK_CONST, "$2_SQRTPI" },
     { TOK_CONST, "$SQRT2" }),

CASE("($pi_+$E)/$2_SQRTPI*$SQRT2",
     { TOK_LPAREN },
     { TOK_CONST, "$pi_" },
     { TOK_PLUS },
     { TOK_CONST, "$E" },
     { TOK_RPAREN },
     { TOK_DIV_1 },
     { TOK_CONST, "$2_SQRTPI" },
     { TOK_MULT },
     { TOK_CONST, "$SQRT2" }),

CASE("\t\t\t\n\r\v\r\t\\cmd arg1 + arg2 * arg3\t\t\t\n\r\v\r\t / "
     "größe español_cigüeña_día\t\t\t\n\r\v\r\t 水 カウンタ сумма "
     "\t\t\t\n\r\v\r\tzß水🍌你好 '  file name你.txt   ' \"  file  ßname2.txt\t\"\t\t\n\v\"🍌\"",
     { TOK_CMD, "\\cmd" },
     { TOK_CMD_ARG, "arg1" },
     { TOK_CMD_ARG, "+" },
     { TOK_CMD_ARG, "arg2" },
     { TOK_CMD_ARG, "*" },
     { TOK_CMD_ARG, "arg3" },
     { TOK_CMD_ARG, "/" },
     { TOK_CMD_ARG, "größe" },
     { TOK_CMD_ARG, "español_cigüeña_día" },
     { TOK_CMD_ARG, "水" },
     { TOK_CMD_ARG, "カウンタ" },
     { TOK_CMD_ARG, "сумма" },
     { TOK_CMD_ARG, "zß水🍌你好" }, /* Yeah, that example from cppreference.com, just a copy-paste.  */
     { TOK_CMD_ARG, "'  file name你.txt   '" },
     { TOK_CMD_ARG, "\"  file  ßname2.txt\t\"" },
     { TOK_CMD_ARG, "\"🍌\"" }),

CASE("\\🍌 你好 -сумма",
     { TOK_CMD, "\\🍌" },
     { TOK_CMD_ARG, "你好" },
     { TOK_CMD_ARG, "-сумма" }),

CASE("\t\t\t\n\r\v\r\t\\c\t\t\t\n\r\v\r\t", { TOK_CMD, "\\c" }),
CASE("\\c", { TOK_CMD, "\\c" }),
CASE("\t\t\t\n\r\v\r\t\\ccc", { TOK_CMD, "\\ccc" }),

/* Other —probably unnecessary— cases, but here they are.  */

CASE("\n\n\n\t\t\t________y25.123456789\n\n\n\n\t\t\v2026.6*18.9+xyz__1__2   -1z2   \n",
     { TOK_NAME, "________y25" },
     { TOK_NUMBER, ".123456789" },
     { TOK_NUMBER, "2026.6" },
     { TOK_MULT },
     { TOK_NUMBER, "18.9" },
     { TOK_PLUS },
     { TOK_NAME, "xyz__1__2" },
     { TOK_MINUS },
     { TOK_NUMBER, "1" },
     { TOK_NAME, "z2" }),

CASE("\n___var23 +\r\r\n\t\v\f2.25____ x {{* \ncomment \n\n\n\n\ngets ignored *}}2y*3+.256545845454848416165156165188888885465144164848115415878445548629461411654515o\n",
     { TOK_NAME, "___var23" },
     { TOK_PLUS },
     { TOK_NUMBER, "2.25" },
     { TOK_NAME, "____" },
     { TOK_NAME, "x" },
     { TOK_NUMBER, "2" },  /* If you read this, have a nice day!  */
     { TOK_NAME, "y" },
     { TOK_MULT },
     { TOK_NUMBER, "3" },
     { TOK_PLUS },
     { TOK_NUMBER, ".256545845454848"
                   "4161651561651888"
                   "8888546514416484"
                   "8115415878445548"
                   "629461411654515" },
     { TOK_NAME, "o" }),

CASE("0000007\r\r\n\t\v\f0.500\n\n\t\n\n\n\t42..999foo{{* a *}}bar{{**}}\r\r\n\t\v\f",
     { TOK_NUMBER, "0000007" },
     { TOK_NUMBER, "0.500" },
     { TOK_NUMBER, "42." },
     { TOK_NUMBER, ".999" },
     { TOK_NAME, "foo" },
     { TOK_NAME, "bar" }),
