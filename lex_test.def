/* Decimal number literals.  */

CASE("0 042 123456 3.14159 .5 1. 1.e2 .0e2 .5e-3 1e10 1.6E-19  6.022e+23 10.0e+20 1_0 1_00 "
     "1_000 1_000_000 1e5..1e7 1.2..1.8 1.0e+2..1.0e+3 0e1_000 0e+1_000 0e-1_000 2e 2E 2ee "
     "2EE 2eee 2e+a _2_ 2__ 2_1 2__1 _2___1 _2 1.0_0_0 1_0.0_1 -1_1 -1e-1_000 +1e-1_000 +0 "
     "-0 0+ 0- -1 +1 1- 1+ ---.1_000e5 ++.8e10 --.1 1-- 0.. 2.0.._3 1.e 1_.0 1_e10 1e+_10  "
     "1e-___   2e+20+1   2e-20*1 2e+20-1 2e++ 2E--  2--e 2e_ 2e+e 2e*e ..1 ...1 ....1 2 .1 "
     "2e1234x++                                                                            ",
     { TOK_NUMBER, "0"         }, { TOK_NUMBER, "042"       }, { TOK_NUMBER, "123456"    },
     { TOK_NUMBER, "3.14159"   }, { TOK_NUMBER, ".5"        }, { TOK_NUMBER, "1."        },
     { TOK_NUMBER, "1.e2"      }, { TOK_NUMBER, ".0e2"      }, { TOK_NUMBER, ".5e-3"     },
     { TOK_NUMBER, "1e10"      }, { TOK_NUMBER, "1.6E-19"   }, { TOK_NUMBER, "6.022e+23" },
     { TOK_NUMBER, "10.0e+20"  }, { TOK_NUMBER, "1_0"       }, { TOK_NUMBER, "1_00"      },
     { TOK_NUMBER, "1_000"     }, { TOK_NUMBER, "1_000_000" }, { TOK_NUMBER, "1e5"       },
     { TOK_RANGE               }, { TOK_NUMBER, "1e7"       }, { TOK_NUMBER, "1.2"       },
     { TOK_RANGE               }, { TOK_NUMBER, "1.8"       }, { TOK_NUMBER, "1.0e+2"    },
     { TOK_RANGE               }, { TOK_NUMBER, "1.0e+3"    }, { TOK_NUMBER, "0e1_000"   },
     { TOK_NUMBER, "0e+1_000"  }, { TOK_NUMBER, "0e-1_000"  }, { TOK_NUMBER, "2"         },
     { TOK_NAME,   "e"         }, { TOK_NUMBER, "2"         }, { TOK_NAME,   "E"         },
     { TOK_NUMBER, "2"         }, { TOK_NAME,   "ee"        }, { TOK_NUMBER, "2"         },
     { TOK_NAME,   "EE"        }, { TOK_NUMBER, "2"         }, { TOK_NAME,   "eee"       },
     { TOK_NUMBER, "2"         }, { TOK_NAME,   "e"         }, { TOK_PLUS                },
     { TOK_NAME,   "a"         }, { TOK_NAME,   "_2_"       }, { TOK_NUMBER, "2"         },
     { TOK_NAME,   "__"        }, { TOK_NUMBER, "2_1"       }, { TOK_NUMBER, "2"         },
     { TOK_NAME,   "__1"       }, { TOK_NAME,   "_2___1"    }, { TOK_NAME,   "_2"        },
     { TOK_NUMBER, "1.0_0_0"   }, { TOK_NUMBER, "1_0.0_1"   }, { TOK_MINUS,              },
     { TOK_NUMBER, "1_1"       }, { TOK_MINUS,              }, { TOK_NUMBER, "1e-1_000"  },
     { TOK_PLUS,               }, { TOK_NUMBER, "1e-1_000"  }, { TOK_PLUS                },
     { TOK_NUMBER, "0"         }, { TOK_MINUS               }, { TOK_NUMBER, "0"         },
     { TOK_NUMBER, "0"         }, { TOK_PLUS                }, { TOK_NUMBER, "0"         },
     { TOK_MINUS               }, { TOK_MINUS               }, { TOK_NUMBER, "1"         },
     { TOK_PLUS                }, { TOK_NUMBER, "1"         }, { TOK_NUMBER, "1"         },
     { TOK_MINUS               }, { TOK_NUMBER, "1"         }, { TOK_PLUS                },
     { TOK_MINUS               }, { TOK_MINUS               }, { TOK_MINUS               },
     { TOK_NUMBER, ".1_000e5"  }, { TOK_PLUS                }, { TOK_PLUS                },
     { TOK_NUMBER, ".8e10"     }, { TOK_MINUS               }, { TOK_MINUS               },
     { TOK_NUMBER, ".1"        }, { TOK_NUMBER, "1"         }, { TOK_MINUS               },
     { TOK_MINUS               }, { TOK_NUMBER, "0"         }, { TOK_RANGE               },
     { TOK_NUMBER, "2.0"       }, { TOK_RANGE               }, { TOK_NAME,   "_3"        },
     { TOK_NUMBER, "1."        }, { TOK_NAME,   "e"         }, { TOK_NUMBER, "1"         },
     { TOK_NAME,   "_"         }, { TOK_NUMBER, ".0"        }, { TOK_NUMBER, "1"         },
     { TOK_NAME,   "_e10"      }, { TOK_NUMBER, "1"         }, { TOK_NAME,   "e"         },
     { TOK_PLUS                }, { TOK_NAME,   "_10"       }, { TOK_NUMBER, "1"         },
     { TOK_NAME,   "e"         }, { TOK_MINUS               }, { TOK_NAME,   "___"       },
     { TOK_NUMBER, "2e+20"     }, { TOK_PLUS                }, { TOK_NUMBER, "1"         },
     { TOK_NUMBER, "2e-20"     }, { TOK_MULT                }, { TOK_NUMBER, "1"         },
     { TOK_NUMBER, "2e+20"     }, { TOK_MINUS               }, { TOK_NUMBER, "1"         },
     { TOK_NUMBER, "2"         }, { TOK_NAME,   "e"         }, { TOK_INC                 },
     { TOK_NUMBER, "2"         }, { TOK_NAME,   "E"         }, { TOK_DEC                 },
     { TOK_NUMBER, "2"         }, { TOK_DEC                 }, { TOK_NAME,   "e"         },
     { TOK_NUMBER, "2"         }, { TOK_NAME,   "e_"        }, { TOK_NUMBER, "2"         },
     { TOK_NAME,   "e"         }, { TOK_PLUS                }, { TOK_NAME, "e"           },
     { TOK_NUMBER, "2"         }, { TOK_NAME,   "e"         }, { TOK_MULT                },
     { TOK_NAME,   "e"         }, { TOK_RANGE               }, { TOK_NUMBER, "1"         },
     { TOK_ELLIPSIS            }, { TOK_NUMBER, "1"         }, { TOK_ELLIPSIS            },
     { TOK_NUMBER, ".1"        }, { TOK_NUMBER, "2"         }, { TOK_NUMBER, ".1"        },
     { TOK_NUMBER, "2e1234"    }, { TOK_NAME,   "x"         }, { TOK_INC                 }),

/* Hexadecimal number literals.  */

CASE("0x0 0x1F 0XFF80 0xabcdef 0xFF_FF_00_00 0x 0 0x+1 0xx 3x 2xx 0x1 2x8 0x_12 0x__ 0x1_ 0xe   "
     "0xaAbBcCdDeEfF 0xaAbBcCdDeEfFgG 0xFF__00 0x0x12 00000xA1 0xa_b_c_d_e_f -0x1 0xa++ 0x++    "
     "0x1.0 0x1. 0x.8 0x1.0p0 0x1.p1 0x.8p2 0x1.0p+10 0x1.0p-10 0x1.0P0 0x1.0p1_000 0x1_0.0_1p0 "
     "0x1.0p 0x1.0p+ 0x1.0p- 0x1.0p_10 0x1.0p1_ 0x1.0p++ 0x1.0p-- 0x1.0p+a 0xA.Bp1..0xC.Dp2     "
     "0x1.0p0..2 0x1.0e1 0x1.0e+1 0x1.0g 0x1.0p1_0_0 0x0.. 0x1..0 0x1.0p+1+1 0xP12 0x.1p+80_10  "
     "0x1234P+1234ABCDEF 0x1234P1234ABCDEF 0x1234P1234XA                                        ",
     { TOK_NUMBER, "0x0"            }, { TOK_NUMBER, "0x1F"           }, { TOK_NUMBER, "0XFF80"         },
     { TOK_NUMBER, "0xabcdef"       }, { TOK_NUMBER, "0xFF_FF_00_00"  }, { TOK_NUMBER, "0"              },
     { TOK_NAME,   "x"              }, { TOK_NUMBER, "0"              }, { TOK_NUMBER, "0"              },
     { TOK_NAME,   "x"              }, { TOK_PLUS                     }, { TOK_NUMBER, "1"              },
     { TOK_NUMBER, "0"              }, { TOK_NAME,   "xx"             }, { TOK_NUMBER, "3"              },
     { TOK_NAME,   "x"              }, { TOK_NUMBER, "2"              }, { TOK_NAME,   "xx"             },
     { TOK_NUMBER, "0x1"            }, { TOK_NUMBER, "2"              }, { TOK_NAME,   "x8"             },
     { TOK_NUMBER, "0"              }, { TOK_NAME,   "x_12"           }, { TOK_NUMBER, "0"              },
     { TOK_NAME,   "x__"            }, { TOK_NUMBER, "0x1"            }, { TOK_NAME,   "_"              },
     { TOK_NUMBER, "0xe"            }, { TOK_NUMBER, "0xaAbBcCdDeEfF" }, { TOK_NUMBER, "0xaAbBcCdDeEfF" },
     { TOK_NAME,   "gG"             }, { TOK_NUMBER, "0xFF"           }, { TOK_NAME,  "__00"            },
     { TOK_NUMBER, "0x0"            }, { TOK_NAME,   "x12"            }, { TOK_NUMBER, "00000"          },
     { TOK_NAME,  "xA1"             }, { TOK_NUMBER, "0xa_b_c_d_e_f"  }, { TOK_MINUS                    },
     { TOK_NUMBER, "0x1"            }, { TOK_NUMBER, "0xa"            }, { TOK_INC                      },
     { TOK_NUMBER, "0"              }, { TOK_NAME,   "x"              }, { TOK_INC                      },
     { TOK_NUMBER, "0x1.0"          }, { TOK_NUMBER, "0x1."           }, { TOK_NUMBER, "0x.8"           },
     { TOK_NUMBER, "0x1.0p0"        }, { TOK_NUMBER, "0x1.p1"         }, { TOK_NUMBER, "0x.8p2"         },
     { TOK_NUMBER, "0x1.0p+10"      }, { TOK_NUMBER, "0x1.0p-10"      }, { TOK_NUMBER, "0x1.0P0"        },
     { TOK_NUMBER, "0x1.0p1_000"    }, { TOK_NUMBER, "0x1_0.0_1p0"    }, { TOK_NUMBER, "0x1.0"          },
     { TOK_NAME,   "p"              }, { TOK_NUMBER, "0x1.0"          }, { TOK_NAME,   "p"              },
     { TOK_PLUS                     }, { TOK_NUMBER, "0x1.0"          }, { TOK_NAME,   "p"              },
     { TOK_MINUS                    }, { TOK_NUMBER, "0x1.0"          }, { TOK_NAME,   "p_10"           },
     { TOK_NUMBER, "0x1.0p1"        }, { TOK_NAME,   "_"              }, { TOK_NUMBER, "0x1.0"          },
     { TOK_NAME,   "p"              }, { TOK_INC                      }, { TOK_NUMBER, "0x1.0"          },
     { TOK_NAME,   "p"              }, { TOK_DEC                      }, { TOK_NUMBER, "0x1.0"          },
     { TOK_NAME,   "p"              }, { TOK_PLUS                     }, { TOK_NAME,   "a"              },
     { TOK_NUMBER, "0xA.Bp1"        }, { TOK_RANGE                    }, { TOK_NUMBER, "0xC.Dp2"        },
     { TOK_NUMBER, "0x1.0p0"        }, { TOK_RANGE                    }, { TOK_NUMBER, "2"              },
     { TOK_NUMBER, "0x1.0e1"        }, { TOK_NUMBER, "0x1.0e"         }, { TOK_PLUS                     },
     { TOK_NUMBER, "1"              }, { TOK_NUMBER, "0x1.0"          }, { TOK_NAME,   "g"              },
     { TOK_NUMBER, "0x1.0p1_0_0"    }, { TOK_NUMBER, "0x0"            }, { TOK_RANGE                    },
     { TOK_NUMBER, "0x1"            }, { TOK_RANGE                    }, { TOK_NUMBER, "0"              },
     { TOK_NUMBER, "0x1.0p+1"       }, { TOK_PLUS                     }, { TOK_NUMBER, "1"              },
     { TOK_NUMBER, "0"              }, { TOK_NAME,   "xP12"           }, { TOK_NUMBER, "0x.1p+80_10"    },
     { TOK_NUMBER, "0x1234P+1234"   }, { TOK_NAME,   "ABCDEF"         }, { TOK_NUMBER, "0x1234P1234"    },
     { TOK_NAME,   "ABCDEF"         }, { TOK_NUMBER, "0x1234P1234"    }, { TOK_NAME,   "XA"             }),

/* Binary number literals.  */

CASE("0b0 0b1 0b1010 0B11001010 0b1111_0000_1010 0b 0 0b+1 0bb 3b 2bb 0b1 2b8 0b_10 0b__ 0b1_ "
     "0b1010a 0b11__00 0b0b10 00000b1 0b1_0_1_0 -0b1 0b1++ 0b++ 0b1e 11 00",
     { TOK_NUMBER, "0b0"        }, { TOK_NUMBER, "0b1"              }, { TOK_NUMBER, "0b1010"    },
     { TOK_NUMBER, "0B11001010" }, { TOK_NUMBER, "0b1111_0000_1010" }, { TOK_NUMBER, "0"         },
     { TOK_NAME,   "b"          }, { TOK_NUMBER, "0"                }, { TOK_NUMBER, "0"         },
     { TOK_NAME,   "b"          }, { TOK_PLUS                       }, { TOK_NUMBER, "1"         },
     { TOK_NUMBER, "0"          }, { TOK_NAME,   "bb"               }, { TOK_NUMBER, "3"         },
     { TOK_NAME,   "b"          }, { TOK_NUMBER, "2"                }, { TOK_NAME,   "bb"        },
     { TOK_NUMBER, "0b1"        }, { TOK_NUMBER, "2"                }, { TOK_NAME,   "b8"        },
     { TOK_NUMBER, "0"          }, { TOK_NAME,   "b_10"             }, { TOK_NUMBER, "0"         },
     { TOK_NAME,   "b__"        }, { TOK_NUMBER, "0b1"              }, { TOK_NAME,   "_"         },
     { TOK_NUMBER, "0b1010"     }, { TOK_NAME,   "a"                }, { TOK_NUMBER, "0b11"      },
     { TOK_NAME,   "__00"       }, { TOK_NUMBER, "0b0"              }, { TOK_NAME,   "b10"       },
     { TOK_NUMBER, "00000"      }, { TOK_NAME,   "b1"               }, { TOK_NUMBER, "0b1_0_1_0" },
     { TOK_MINUS                }, { TOK_NUMBER, "0b1"              }, { TOK_NUMBER, "0b1"       },
     { TOK_PLUS                 }, { TOK_PLUS                       }, { TOK_NUMBER, "0"         },
     { TOK_NAME,   "b"          }, { TOK_INC                        }, { TOK_NUMBER, "0b1"       },
     { TOK_NAME,   "e"          }, { TOK_NUMBER, "11"               }, { TOK_NUMBER, "00"        }),

/* Octal number literals.  */

CASE("0o0 0o755 0O777 0o123_456 0o1_2_3_4_5_6_7 0o 0 0o+1 0oo 3o 2oo 0o1 2o8 0o_12 0o__ 0o1_ "
     "0o755a 0o77__00 0o0o12 00000o1 -0o1 0o755++ 0o++ 0oe",
     { TOK_NUMBER, "0o0"       }, { TOK_NUMBER, "0o755"           }, { TOK_NUMBER, "0O777" },
     { TOK_NUMBER, "0o123_456" }, { TOK_NUMBER, "0o1_2_3_4_5_6_7" }, { TOK_NUMBER, "0"     },
     { TOK_NAME,   "o"         }, { TOK_NUMBER, "0"               }, { TOK_NUMBER, "0"     },
     { TOK_NAME,   "o"         }, { TOK_PLUS                      }, { TOK_NUMBER, "1"     },
     { TOK_NUMBER, "0"         }, { TOK_NAME,   "oo"              }, { TOK_NUMBER, "3"     },
     { TOK_NAME,   "o"         }, { TOK_NUMBER, "2"               }, { TOK_NAME,   "oo"    },
     { TOK_NUMBER, "0o1"       }, { TOK_NUMBER, "2"               }, { TOK_NAME,   "o8"    },
     { TOK_NUMBER, "0"         }, { TOK_NAME,   "o_12"            }, { TOK_NUMBER, "0"     },
     { TOK_NAME,   "o__"       }, { TOK_NUMBER, "0o1"             }, { TOK_NAME,   "_"     },
     { TOK_NUMBER, "0o755"     }, { TOK_NAME,   "a"               }, { TOK_NUMBER, "0o77"  },
     { TOK_NAME,   "__00"      }, { TOK_NUMBER, "0o0"             }, { TOK_NAME,   "o12"   },
     { TOK_NUMBER, "00000"     }, { TOK_NAME,   "o1"              }, { TOK_MINUS           },
     { TOK_NUMBER, "0o1"       }, { TOK_NUMBER, "0o755"           }, { TOK_PLUS            },
     { TOK_PLUS                }, { TOK_NUMBER, "0"               }, { TOK_NAME,   "o"     },
     { TOK_INC                 }, { TOK_NUMBER, "0"               }, { TOK_NAME,   "oe"    }),

/* String literals.  */

CASE(R"("" "     " "This is a string." "This is an \"escaped\" string."
     "Line 1\nLine 2\nLine3\tTab" "\\\\" "           pad           "
     " {{* comment *}} " "if (x == \"🍌水你好\") { return 0; }"
     "\x41\x42\x43"
     let const char *str := "Lorem ipsum dolor sit amet." and "4x^2 + 5 = 13"
     "\"" "\\" "\\\"" "\\\\" "\\\\\"" " \ " "''")",
     { TOK_STRING, "" },
     { TOK_STRING, "     " },
     { TOK_STRING, "This is a string." },
     { TOK_STRING, "This is an \\\"escaped\\\" string." },
     { TOK_STRING, "Line 1\\nLine 2\\nLine3\\tTab" },
     { TOK_STRING, "\\\\\\\\" },
     { TOK_STRING, "           pad           " },
     { TOK_STRING, " {{* comment *}} " },
     { TOK_STRING, "if (x == \\\"🍌水你好\\\") { return 0; }" },
     { TOK_STRING, "\\x41\\x42\\x43" },
     { TOK_NAME, "let" },
     { TOK_NAME, "const" },
     { TOK_NAME, "char" },
     { TOK_MULT },
     { TOK_NAME, "str" },
     { TOK_ASSIGN },
     { TOK_STRING, "Lorem ipsum dolor sit amet." },
     { TOK_NAME, "and" },
     { TOK_STRING, "4x^2 + 5 = 13" },
     { TOK_STRING, "\\\"" },
     { TOK_STRING, "\\\\" },
     { TOK_STRING, "\\\\\\\"" },
     { TOK_STRING, "\\\\\\\\" },
     { TOK_STRING, "\\\\\\\\\\\"" },
     { TOK_STRING, " \\ " },
     { TOK_STRING, "''" }),

/* Arithmetic operators.  */
CASE("+ - * / ÷ % +- ** ⌊x + 1⌋*⌈y - 2⌉ + [a, b]* {c} ++a%b**(-4) "
     "++5 +++5 +++++5 ++a +++🍌水你好 +++++a --5 ---5 -----5 --a ---🍌水你好 -----a ++水 --水 "
     "5++ 5+++ 5+++++ a++ 水你好🍌+++ a+++++ 5-- 5--- 5----- a-- 🍌水你好--- a----- 水++ 水-- " /* Increment/decrement operators apply only to identifiers,  */
     "(5)++ [5]+++ {5}++++ (a)++ [a]+++ {a}++++ --(5) ---[5] ----{5} --(a) ---[a] ----{a}  " /* unless those are surrounded by grouping operators.  */
     "5++a a++5 5--a a--5 5--5 5++5 a ++ a a -- a a++a a++a++ ++a--a++",

     /* First line.  */

     { TOK_PLUS      }, { TOK_MINUS     }, { TOK_MULT        }, { TOK_DIV_1       }, { TOK_DIV_2     },
     { TOK_MOD       }, { TOK_PLUS      }, { TOK_MINUS       }, { TOK_EXP         }, { TOK_LFLOOR    },
     { TOK_NAME, "x" }, { TOK_PLUS      }, { TOK_NUMBER, "1" }, { TOK_RFLOOR      }, { TOK_MULT      },
     { TOK_LCEILING  }, { TOK_NAME, "y" }, { TOK_MINUS       }, { TOK_NUMBER, "2" }, { TOK_RCEILING  },
     { TOK_PLUS      }, { TOK_LBRACKET  }, { TOK_NAME, "a"   }, { TOK_COMMA       }, { TOK_NAME, "b" },
     { TOK_RBRACKET  }, { TOK_MULT      }, { TOK_LBRACE      }, { TOK_NAME, "c"   }, { TOK_RBRACE    },
     { TOK_INC       }, { TOK_NAME, "a" }, { TOK_MOD         }, { TOK_NAME, "b"   }, { TOK_EXP       },
     { TOK_LPAREN    }, { TOK_MINUS     }, { TOK_NUMBER, "4" }, { TOK_RPAREN      },

     /* Second line.  */

     { TOK_PLUS  }, { TOK_PLUS       }, { TOK_NUMBER, "5"     },
     { TOK_PLUS  }, { TOK_PLUS       }, { TOK_PLUS            }, { TOK_NUMBER, "5" },
     { TOK_PLUS  }, { TOK_PLUS       }, { TOK_PLUS            }, { TOK_PLUS        }, { TOK_PLUS      }, { TOK_NUMBER, "5" },
     { TOK_INC   }, { TOK_NAME, "a"  },
     { TOK_PLUS  }, { TOK_INC        }, { TOK_NAME, "🍌水你好" },
     { TOK_PLUS  }, { TOK_PLUS       }, { TOK_PLUS            }, { TOK_INC         }, { TOK_NAME, "a" },
     { TOK_MINUS }, { TOK_MINUS      }, { TOK_NUMBER, "5"     },
     { TOK_MINUS }, { TOK_MINUS      }, { TOK_MINUS           }, { TOK_NUMBER, "5" },
     { TOK_MINUS }, { TOK_MINUS      }, { TOK_MINUS           }, { TOK_MINUS       }, { TOK_MINUS     }, { TOK_NUMBER, "5" },
     { TOK_DEC   }, { TOK_NAME, "a"  },
     { TOK_MINUS }, { TOK_DEC        }, { TOK_NAME, "🍌水你好" },
     { TOK_MINUS }, { TOK_MINUS      }, { TOK_MINUS           }, { TOK_DEC         }, { TOK_NAME, "a" },
     { TOK_INC   }, { TOK_NAME, "水" },
     { TOK_DEC   }, { TOK_NAME, "水" },

     /* Third line.  */

     { TOK_NUMBER, "5"       }, { TOK_PLUS  }, { TOK_PLUS  },
     { TOK_NUMBER, "5"       }, { TOK_PLUS  }, { TOK_PLUS  }, { TOK_PLUS  },
     { TOK_NUMBER, "5"       }, { TOK_PLUS  }, { TOK_PLUS  }, { TOK_PLUS  }, { TOK_PLUS }, { TOK_PLUS },
     { TOK_NAME,   "a"       }, { TOK_INC   },
     { TOK_NAME,   "水你好🍌" }, { TOK_INC   }, { TOK_PLUS  },
     { TOK_NAME,   "a"       }, { TOK_INC   }, { TOK_PLUS  }, { TOK_PLUS  }, { TOK_PLUS },
     { TOK_NUMBER, "5"       }, { TOK_MINUS }, { TOK_MINUS },
     { TOK_NUMBER, "5"       }, { TOK_MINUS }, { TOK_MINUS }, { TOK_MINUS },
     { TOK_NUMBER, "5"       }, { TOK_MINUS }, { TOK_MINUS }, { TOK_MINUS }, { TOK_MINUS }, { TOK_MINUS },
     { TOK_NAME,   "a"       }, { TOK_DEC   },
     { TOK_NAME,   "🍌水你好" }, { TOK_DEC   }, { TOK_MINUS },
     { TOK_NAME,   "a"       }, { TOK_DEC   }, { TOK_MINUS }, { TOK_MINUS }, { TOK_MINUS },
     { TOK_NAME,   "水"      }, { TOK_INC   },
     { TOK_NAME,   "水"      },  { TOK_DEC   },

     /* Fourth line.  */

     { TOK_LPAREN   }, { TOK_NUMBER, "5" }, { TOK_RPAREN   }, { TOK_PLUS        }, { TOK_PLUS        },
     { TOK_LBRACKET }, { TOK_NUMBER, "5" }, { TOK_RBRACKET }, { TOK_PLUS        }, { TOK_PLUS        }, { TOK_PLUS        },
     { TOK_LBRACE   }, { TOK_NUMBER, "5" }, { TOK_RBRACE   }, { TOK_PLUS        }, { TOK_PLUS        }, { TOK_PLUS        }, { TOK_PLUS   },
     { TOK_LPAREN   }, { TOK_NAME, "a"   }, { TOK_RPAREN   }, { TOK_PLUS        }, { TOK_PLUS        },
     { TOK_LBRACKET }, { TOK_NAME, "a"   }, { TOK_RBRACKET }, { TOK_PLUS        }, { TOK_PLUS        }, { TOK_PLUS        },
