{{* Inline function. *}}
f(x, y) := x + y ^ 2;
f := func(x: int, y: int): int => x + y ^ 2;

{{* Composite function. *}}
func f(x: int, y: int): int {
	z := x * y * 2;
	z := y ^ 2;
	--z;
	return 1 + z;
}

{{* Variable declarations. *}}
x := 1;
x: int := 1;
b := false;
b: bool := false;
x := 42;
x: int := 42;

{{* Set declarations. *}}
A := {1, 2, 3};
B := {x ∈ A | x > 1};
